# Copy this file to ".env" (same folder). Demo Mode works without it.
# The Supabase adapter is a stub (see supabase/README.md), so these are not used yet.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER put the "service_role" key in this file. Variables starting with VITE_ are visible to every visitor.
